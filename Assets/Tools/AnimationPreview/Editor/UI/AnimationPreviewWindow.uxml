<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement class="window-root">
        <ui:VisualElement class="toolbar-row">
            <uie:ObjectField name="profile-field" label="Profile" class="toolbar-field" />
            <ui:Button name="new-profile-button" text="新建" />
            <ui:Button name="save-profile-button" text="保存" />
            <ui:Label name="dirty-label" class="dirty-label" />
            <ui:VisualElement class="toolbar-spacer" />
            <ui:Button name="refresh-button" text="刷新资源" />
            <ui:Button name="focus-mode-button" text="专注预览" />
        </ui:VisualElement>
        <ui:VisualElement class="model-row">
            <uie:ObjectField name="model-field" label="模型 FBX / Prefab" class="model-field" />
            <ui:Label text="也可将模型直接拖到中央视口" class="hint-label" />
        </ui:VisualElement>
        <ui:VisualElement class="main-row">
            <ui:VisualElement name="left-pane" class="side-pane left-pane">
                <ui:VisualElement name="mode-container" class="mode-container" />
                <ui:VisualElement name="sequence-panel" class="sequence-panel">
                    <ui:Label text="Animation Sequence" class="section-title" />
                    <ui:VisualElement class="source-actions">
                        <uie:ObjectField name="sequence-field" label="当前 Sequence" class="sequence-field" />
                        <ui:Button name="new-sequence-button" text="新建" />
                    </ui:VisualElement>
                    <ui:ListView name="sequence-entry-list" class="sequence-entry-list" fixed-item-height="38" />
                </ui:VisualElement>
                <ui:Label text="动画资源" class="section-title" />
                <uie:ToolbarSearchField name="search-field" />
                <ui:Toggle name="scan-all-toggle" label="扫描整个 Assets" />
                <ui:VisualElement name="animation-drop-zone" class="drop-zone">
                    <ui:Label text="拖入动画 FBX、AnimationClip 或文件夹" />
                </ui:VisualElement>
                <uie:ObjectField name="source-field" label="动画来源" />
                <ui:VisualElement class="source-actions">
                    <ui:Button name="remove-source-button" text="移除" />
                </ui:VisualElement>
                <ui:ListView name="source-list" class="source-list" fixed-item-height="22" />
                <ui:Label name="clip-count-label" class="clip-count" />
                <ui:Button name="favorite-button" text="收藏" />
                <ui:ListView name="clip-list" class="clip-list" />
            </ui:VisualElement>
            <ui:VisualElement class="preview-column">
                <ui:VisualElement class="view-toolbar">
                    <ui:Button name="front-view-button" text="正面" />
                    <ui:Button name="side-view-button" text="侧面" />
                    <ui:Button name="back-view-button" text="背面" />
                    <ui:Button name="focus-button" text="聚焦" />
                </ui:VisualElement>
                <ui:VisualElement name="preview-container" class="preview-container" />
            </ui:VisualElement>
            <ui:VisualElement name="right-pane" class="side-pane right-pane">
                <ui:Label text="模型信息" class="section-title" />
                <ui:Label name="model-info" class="info-block" />
                <ui:Label text="动画信息" class="section-title" />
                <ui:Label name="clip-info" class="info-block" />
                <ui:Label text="兼容性" class="section-title" />
                <ui:Label name="compatibility-info" class="status-label" />
                <ui:Label text="Motion Tools" class="section-title" />
                <uie:ObjectField name="motion-profile-field" label="Motion Profile" />
                <uie:IntegerField name="motion-sample-rate-field" label="Sample Rate" value="60" />
                <ui:VisualElement class="source-actions">
                    <ui:Button name="motion-bake-button" text="Bake" />
                    <ui:Button name="motion-rebake-button" text="Rebake" />
                    <ui:Button name="motion-validate-button" text="Validate" />
                </ui:VisualElement>
                <ui:Button name="motion-trajectory-button" text="Show Trajectory" />
                <ui:Label name="motion-validation-label" class="status-label" />
                <ui:Label text="Foot Calibration" class="section-title" />
                <uie:ObjectField name="foot-calibration-field" label="校准资源" />
                <uie:Vector3Field name="left-foot-offset-field" label="左脚底偏移" />
                <uie:Vector3Field name="right-foot-offset-field" label="右脚底偏移" />
                <uie:FloatField name="virtual-ground-field" label="虚拟地面高度" />
                <ui:Toggle name="foot-probes-toggle" label="显示脚底探针" value="true" />
                <ui:Label text="Plant Marker（仅编辑器）" class="section-title" />
                <ui:VisualElement class="source-actions">
                    <ui:Button name="mark-left-plant-button" text="标记 Left Plant" />
                    <ui:Button name="mark-right-plant-button" text="标记 Right Plant" />
                    <ui:Button name="delete-plant-button" text="删除 Plant" />
                </ui:VisualElement>
                <ui:Label text="显示设置" class="section-title" />
                <uie:ColorField name="background-field" label="背景" value="#1B1D21" />
                <ui:Slider name="light-intensity-slider" label="主光强度" low-value="0" high-value="5" value="1.2" show-input-field="true" />
                <uie:Vector2Field name="light-rotation-field" label="主光旋转" />
                <uie:EnumField name="root-motion-field" label="Root Motion" />
                <ui:Toggle name="grid-toggle" label="地面网格" value="true" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="plant-marker-track" class="plant-marker-track" />
        <ui:VisualElement class="playback-row">
            <ui:Button name="previous-frame-button" text="|◀" />
            <ui:Button name="play-button" text="播放" />
            <ui:Button name="stop-button" text="停止" />
            <ui:Button name="next-frame-button" text="▶|" />
            <ui:Button name="reset-button" text="复位" />
            <ui:Toggle name="loop-toggle" label="循环" value="true" />
            <ui:Slider name="speed-slider" label="速度" low-value="0.1" high-value="2" value="1" show-input-field="true" class="speed-slider" />
            <ui:Slider name="time-slider" low-value="0" high-value="1" value="0" class="time-slider" />
            <ui:Label name="time-label" text="0.00 / 0.00" class="time-label" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
